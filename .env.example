# Defaults are suitable for access from the Docker host only.
BIND_ADDRESS=127.0.0.1
PORT=3000
MAX_APK_MB=512

# For access from other devices, set BIND_ADDRESS=0.0.0.0 and a strong password.
# Browser login accepts any username; use this password.
APP_PASSWORD=
# Optional comma-separated additional hostnames, e.g. tv-bridge.home
# Numeric IP addresses and localhost are already accepted.
APP_ALLOWED_HOSTS=
